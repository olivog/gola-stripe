@model GolaStripe.Models.ReceiptVm
@{
    ViewBag.Title = Strings.Receipt_Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.Partial("_ReceiptStyles")

<div class="receipt-wrap">
@if (Model == null)
{
    if (!string.IsNullOrEmpty(ViewBag.Error as string))
    {
        <p class="err">@ViewBag.Error</p>
    }
    else
    {
        <h1>@Strings.Receipt_NotFoundTitle</h1>
        <p>@Strings.Receipt_NotFoundBody</p>
        <p class="hint">@Strings.Receipt_HelpHint</p>
    }
}
else
{
    @Html.Partial("_Receipt", Model)

    <div class="actions no-print">
        <button type="button" class="btn" onclick="window.print()">@Strings.Receipt_SavePdf</button>
        <p class="hint">@Strings.Receipt_PrintHint</p>
    </div>
}
</div>
