@* Estilos del recibo (pantalla + impresión/PDF). Usado por Success.cshtml y Receipt.cshtml *@
<style>
    .receipt-wrap { max-width: 36rem; }
    .receipt {
        background: #fff;
        color: #0f172a;
        border-radius: 12px;
        padding: 1.75rem 1.5rem;
        box-shadow: 0 8px 30px rgba(0,0,0,.35);
    }
    .receipt-logo { display: block; max-height: 56px; width: auto; margin: 0 auto 1.25rem; }
    .receipt-title { text-align: center; margin: 0 0 .25rem; font-size: 1.35rem; color: #0f172a; }
    .receipt-sub { text-align: center; margin: 0 0 1.25rem; color: #64748b; font-size: .9rem; }
    .receipt-meta { font-size: .85rem; color: #334155; margin-bottom: 1.25rem; }
    .receipt-meta div { margin: .2rem 0; }
    .receipt-meta strong { color: #0f172a; }
    table.lines {
        width: 100%;
        border-collapse: collapse;
        font-size: .95rem;
        margin-bottom: 1rem;
    }
    table.lines th {
        text-align: left;
        border-bottom: 2px solid #e2e8f0;
        padding: .5rem 0;
        color: #64748b;
        font-weight: 600;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    /* Columnas numéricas (QTY / PRICE / AMOUNT): separación visible en pantallas angostas */
    table.lines th.num, table.lines td.num { text-align: right; padding-left: 12px; white-space: nowrap; }
    table.lines th.qty, table.lines td.qty { width: 3rem; }
    table.lines td:first-child { overflow-wrap: anywhere; word-break: break-word; }

    /* Teléfonos: menos margen alrededor para que las columnas numéricas (nowrap) quepan sin desbordar */
    @@media (max-width: 480px) {
        body { margin: 1rem; }
        .receipt { padding: 1.25rem 1rem; }
        table.lines { font-size: .875rem; }
        table.lines th { letter-spacing: 0; }
        table.lines th.qty, table.lines td.qty { width: auto; }
    }
    @@media (max-width: 360px) {
        body { margin: .5rem; }
        .receipt { padding: 1rem .75rem; }
    }
    table.lines td {
        padding: .65rem 0;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: top;
    }
    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        padding-top: .75rem;
        border-top: 2px solid #0f172a;
        font-size: 1.1rem;
        font-weight: 700;
    }
    .badge {
        display: inline-block;
        padding: .15rem .55rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
        background: #dcfce7;
        color: #166534;
    }
    .badge.pending { background: #fef9c3; color: #854d0e; }
    .actions {
        margin-top: 1.25rem;
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        align-items: center;
    }
    .btn {
        appearance: none;
        border: 0;
        border-radius: 8px;
        padding: .65rem 1.1rem;
        font-weight: 600;
        cursor: pointer;
        background: #38bdf8;
        color: #0f172a;
        text-decoration: none;
        font-size: .95rem;
    }
    .btn.secondary { background: #334155; color: #e2e8f0; }
    .hint { font-size: .8rem; color: #94a3b8; margin: 0; }
    .err { color: #f87171; }

    @@media print {
        body { background: #fff !important; color: #000 !important; margin: 0 !important; }
        main { max-width: none !important; }
        .no-print { display: none !important; }
        .receipt {
            box-shadow: none !important;
            border-radius: 0 !important;
            padding: 0 !important;
            max-width: 100% !important;
        }
        a { color: inherit; text-decoration: none; }
    }
</style>
