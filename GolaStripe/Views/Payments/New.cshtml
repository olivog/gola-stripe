@{
    ViewBag.Title = Strings.New_Title;
    var customerLang = Lang.NormalizeOrDefault(ViewBag.CustomerLang as string);
}

<style>
    .box { max-width: 28rem; }
    label { font-size: .9rem; color: #94a3b8; }
    input, select {
        width: 100%;
        padding: .5rem;
        border-radius: .35rem;
        border: 1px solid #334155;
        background: #1e293b;
        color: #e2e8f0;
        box-sizing: border-box;
    }
    button {
        padding: .75rem 1.25rem;
        background: #38bdf8;
        color: #0f172a;
        border: 0;
        border-radius: .5rem;
        font-weight: 600;
        cursor: pointer;
    }
    .err { color: #f87171; }
    .muted { color: #94a3b8; font-size: .9rem; }
</style>

<div class="box">
    <h1>@Strings.New_Title</h1>
    <p class="muted">@Strings.New_Intro</p>

    @if (!string.IsNullOrEmpty(ViewBag.Error as string))
    {
        <p class="err">@ViewBag.Error</p>
    }

    @using (Html.BeginForm("CreateCheckout", "Payments", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <p>
            <label for="productName">@Strings.New_ProductName</label><br />
            <input id="productName" name="productName" type="text" maxlength="200" required
                   value="@(ViewBag.ProductName ?? "")" />
        </p>

        <p>
            <label for="amountDollars">@Strings.New_Price</label><br />
            <input id="amountDollars" name="amountDollars" type="number" min="0.50" max="99999.99" step="0.01" required
                   value="@(ViewBag.AmountDollars ?? "10.00")" />
        </p>

        <p>
            <label for="customerLang">@Strings.New_CustomerLanguage</label><br />
            <select id="customerLang" name="customerLang">
                @foreach (var code in Lang.Supported)
                {
                    <option value="@code" lang="@code" selected="@(code == customerLang)">@Lang.DisplayName(code)</option>
                }
            </select><br />
            <span class="muted">@Strings.New_CustomerLanguageHint</span>
        </p>

        <p>
            <button type="submit">@Strings.New_Submit</button>
        </p>
    }
</div>
