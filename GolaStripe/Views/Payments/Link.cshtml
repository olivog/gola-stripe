@{
    ViewBag.Title = "Link de pago";
    var url = ViewBag.CheckoutUrl as string;
    var money = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    var amount = ViewBag.AmountDollars is decimal ? (decimal)ViewBag.AmountDollars : Convert.ToDecimal(ViewBag.AmountDollars);
}

<style>
    .box { max-width: 36rem; }
    .card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 1.25rem 1.35rem;
        margin: 1rem 0;
    }
    .meta { color: #94a3b8; font-size: .9rem; margin: .25rem 0; }
    .meta strong { color: #e2e8f0; }
    .ok { color: #4ade80; font-weight: 600; }
    .link-row {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
        align-items: stretch;
        margin-top: .75rem;
    }
    .link-row input {
        flex: 1 1 14rem;
        min-width: 0;
        padding: .55rem .65rem;
        border-radius: .4rem;
        border: 1px solid #334155;
        background: #0f172a;
        color: #e2e8f0;
        font-size: .85rem;
    }
    .btn {
        appearance: none;
        border: 0;
        border-radius: .5rem;
        padding: .55rem 1rem;
        font-weight: 600;
        cursor: pointer;
        background: #38bdf8;
        color: #0f172a;
        text-decoration: none;
        display: inline-block;
        font-size: .9rem;
        line-height: 1.3;
    }
    .btn.secondary { background: #334155; color: #e2e8f0; }
    .hint { color: #64748b; font-size: .8rem; margin-top: .75rem; }
    #copyMsg { color: #4ade80; font-size: .85rem; min-height: 1.2em; }
</style>

<div class="box">
    <h1>Link de pago listo</h1>
    <p class="ok">Orden Pending creada. Copia el link y envíaselo al cliente.</p>

    <div class="card">
        <p class="meta"><strong>Orden:</strong> #@ViewBag.OrderId</p>
        <p class="meta"><strong>Producto:</strong> @ViewBag.ProductName</p>
        <p class="meta"><strong>Monto:</strong> @amount.ToString("C", money) @ViewBag.Currency</p>
        <p class="meta"><strong>Estado:</strong> Pending</p>

        <div class="link-row">
            <input id="checkoutUrl" type="text" readonly value="@url" onclick="this.select();" />
            <button type="button" class="btn" id="btnCopy">Copiar link</button>
        </div>
        <p id="copyMsg"></p>
    </div>

    <p>
        <a class="btn secondary" href="@url" target="_blank" rel="noopener">Abrir Checkout</a>
        <a class="btn secondary" href="@Url.Action("New", "Payments")">Crear otro</a>
        <a class="btn secondary" href="@Url.Action("Index", "Home")">Inicio</a>
    </p>

    <p class="hint">El link es de Stripe Checkout (Test). Si el cliente cancela, la orden pasa a Cancelled; si la sesión expira, a Expired.</p>
</div>

<script>
(function () {
    var input = document.getElementById('checkoutUrl');
    var btn = document.getElementById('btnCopy');
    var msg = document.getElementById('copyMsg');
    if (!btn || !input) return;

    btn.addEventListener('click', function () {
        var text = input.value;
        function ok() {
            msg.textContent = 'Copiado.';
            setTimeout(function () { msg.textContent = ''; }, 2000);
        }
        function fail() {
            input.focus();
            input.select();
            msg.textContent = 'Selecciona y copia con Ctrl+C.';
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(ok).catch(fail);
        } else {
            try {
                input.focus();
                input.select();
                document.execCommand('copy');
                ok();
            } catch (e) {
                fail();
            }
        }
    });
})();
</script>