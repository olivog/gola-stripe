@model GolaStripe.Models.ReceiptVm
@* Recibo compartido por Success.cshtml y Receipt.cshtml. Montos: USD fijo en-US (Money.Format). *@
@{
    var isPaid = string.Equals(Model.Status, "Paid", StringComparison.OrdinalIgnoreCase);
}

<div class="receipt" id="receipt">
    <img class="receipt-logo" src="~/Content/images/gola-logo.png" alt="Gola" />
    <h1 class="receipt-title">@Strings.Receipt_Title</h1>
    <p class="receipt-sub">
        <span class="badge @(isPaid ? "" : "pending")">@Lang.StatusLabel(Model.Status)</span>
        @if (Model.OrderId > 0)
        {
            <text> · @string.Format(Strings.Receipt_OrderNumber, Model.OrderId)</text>
        }
    </p>

    <div class="receipt-meta">
        @if (!string.IsNullOrEmpty(Model.CustomerName))
        {
            <div><strong>@Strings.Label_Customer:</strong> @Model.CustomerName</div>
        }
        @if (!string.IsNullOrEmpty(Model.CustomerEmail))
        {
            <div><strong>@Strings.Label_Email:</strong> @Model.CustomerEmail</div>
        }
        @if (!string.IsNullOrEmpty(Model.CustomerCountry))
        {
            <div><strong>@Strings.Label_Country:</strong> @Model.CustomerCountry</div>
        }
        @if (Model.PaidAtUtc.HasValue)
        {
            <div><strong>@Strings.Label_PaidOn:</strong> @Lang.FormatAst(Model.PaidAtUtc.Value, null)</div>
        }
        @if (!string.IsNullOrEmpty(Model.CardBrand) && !string.IsNullOrEmpty(Model.CardLast4))
        {
            <div><strong>@Strings.Label_Card:</strong> @Model.CardBrand •••• @Model.CardLast4</div>
        }
        @if (Model.PublicOrderId != Guid.Empty)
        {
            <div><strong>@Strings.Label_Ref:</strong> <code style="font-size:.75rem">@Model.PublicOrderId</code></div>
        }
    </div>

    <table class="lines">
        <thead>
            <tr>
                <th>@Strings.Col_Description</th>
                <th class="num qty">@Strings.Col_Qty</th>
                <th class="num">@Strings.Col_Price</th>
                <th class="num">@Strings.Col_Amount</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Lines != null && Model.Lines.Count > 0)
        {
            foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.Name</td>
                    <td class="num qty">@line.Quantity</td>
                    <td class="num">@Money.Format(line.UnitAmount)</td>
                    <td class="num">@Money.Format(line.LineTotal)</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4">@Strings.Receipt_NoItems</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="total-row">
        <span>@Strings.Label_Total (@Model.CurrencyUpper)</span>
        <span style="white-space:nowrap">@Money.Format(Model.AmountTotal)</span>
    </div>
</div>
