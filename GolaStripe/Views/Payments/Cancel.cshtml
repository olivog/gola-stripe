@{
    ViewBag.Title = "Pago cancelado";
    var status = ViewBag.OrderStatus as string;
    var orderId = ViewBag.OrderId as long?;
    var justCancelled = ViewBag.JustCancelled as bool? == true;
}

<style>
    .box { max-width: 36rem; }
    .badge {
        display: inline-block;
        padding: .15rem .55rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
        background: #fef9c3;
        color: #854d0e;
    }
    .badge.cancelled { background: #fee2e2; color: #991b1b; }
    .badge.paid { background: #dcfce7; color: #166534; }
    .badge.expired { background: #e2e8f0; color: #334155; }
    .muted { color: #94a3b8; font-size: .9rem; }
    a.btn {
        display: inline-block;
        margin-top: 1rem;
        margin-right: .5rem;
        padding: .55rem 1rem;
        border-radius: 8px;
        background: #38bdf8;
        color: #0f172a;
        font-weight: 600;
        text-decoration: none;
    }
    a.btn.secondary { background: #334155; color: #e2e8f0; }
</style>

<div class="box">
    <h1>Pago cancelado</h1>
    <p>No se cobró nada. Saliste del Checkout o cancelaste el pago.</p>

    @if (!string.IsNullOrEmpty(ViewBag.Error as string))
    {
        <p style="color:#f87171">@ViewBag.Error</p>
    }
    else if (orderId != null)
    {
        var badgeClass = "";
        if (string.Equals(status, "Cancelled", StringComparison.OrdinalIgnoreCase)) { badgeClass = "cancelled"; }
        else if (string.Equals(status, "Paid", StringComparison.OrdinalIgnoreCase)) { badgeClass = "paid"; }
        else if (string.Equals(status, "Expired", StringComparison.OrdinalIgnoreCase)) { badgeClass = "expired"; }

        <p>
            Orden #@orderId
            @if (!string.IsNullOrEmpty(status))
            {
                <span class="badge @badgeClass">@status</span>
            }
        </p>
        if (justCancelled)
        {
            <p class="muted">La orden pasó de Pending a Cancelled.</p>
        }
        else if (string.Equals(status, "Cancelled", StringComparison.OrdinalIgnoreCase))
        {
            <p class="muted">Esta orden ya estaba cancelada.</p>
        }
        else if (string.Equals(status, "Paid", StringComparison.OrdinalIgnoreCase))
        {
            <p class="muted">Esta orden ya figura como pagada (no se modificó).</p>
        }
        else if (string.Equals(status, "Pending", StringComparison.OrdinalIgnoreCase))
        {
            <p class="muted">Sigue Pending; si la sesión de Stripe expira, pasará a Expired por webhook.</p>
        }
    }
    else if (!string.IsNullOrEmpty(ViewBag.SessionId as string))
    {
        <p class="muted">No encontramos una orden para esta sesión.</p>
    }

    <p>
        <a class="btn" href="@Url.Action("New", "Payments")">Intentar de nuevo</a>
        <a class="btn secondary" href="@Url.Action("Index", "Home")">Inicio</a>
    </p>
</div>